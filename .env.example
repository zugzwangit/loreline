# Required production secrets. Replace every local default before deployment.
POSTGRES_PASSWORD=replace-with-32-random-characters
MINIO_ROOT_USER=replace-access-key
MINIO_ROOT_PASSWORD=replace-with-32-random-characters
GRAFANA_ADMIN_PASSWORD=replace-with-32-random-characters

# Public origins and edge hostname.
LORELINE_ALLOWED_ORIGINS=https://knowledge.example.com
LORELINE_DOMAIN=knowledge.example.com
LORELINE_RATE_PER_MINUTE=120

# Optional generation provider. `extractive` works without external credentials.
LORELINE_PROVIDER=extractive
LORELINE_PROVIDER_BASE_URL=https://api.openai.com/v1
LORELINE_PROVIDER_MODEL=
LORELINE_PROVIDER_API_KEY=
