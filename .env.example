# Required production secrets. Replace every local default before deployment.
POSTGRES_PASSWORD=replace-with-32-random-characters
MINIO_ROOT_USER=replace-access-key
MINIO_ROOT_PASSWORD=replace-with-32-random-characters
GRAFANA_ADMIN_PASSWORD=replace-with-32-random-characters

# Public origins and edge hostname.
LORELINE_ALLOWED_ORIGINS=https://knowledge.example.com
LORELINE_DOMAIN=knowledge.example.com
LORELINE_RATE_PER_MINUTE=120

# Server-only console proxy configuration. Never use NEXT_PUBLIC_ for these values.
LORELINE_GATEWAY_URL=https://knowledge.example.com
LORELINE_GATEWAY_TOKEN=ll_live_replace-me
# Optional comma-separated authorization layer in addition to the private Sites access policy.
LORELINE_ALLOWED_USER_EMAILS=owner@example.com

# Operator-controlled egress allowlist for source connectors. Use exact hostnames.
LORELINE_CONNECTOR_ALLOWED_HOSTS=example.atlassian.net,example.zendesk.com,api.example.com
# Connector secrets must use the LORELINE_CONNECTOR_ prefix.
LORELINE_CONNECTOR_CREDENTIAL={"email":"operator@example.com","token":"replace-me"}
LORELINE_CONNECTOR_TOKEN=replace-me

# Optional generation provider. `extractive` works without external credentials.
LORELINE_PROVIDER=extractive
LORELINE_PROVIDER_BASE_URL=https://api.openai.com/v1
LORELINE_PROVIDER_MODEL=
LORELINE_PROVIDER_API_KEY=
